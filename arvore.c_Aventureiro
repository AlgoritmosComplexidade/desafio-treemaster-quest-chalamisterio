}

void limparBuffer() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

void removerQuebraLinha(char* string) {
    size_t tamanho = strlen(string);
    if (tamanho > 0 && string[tamanho - 1] == '\n') {
        string[tamanho - 1] = '\0';
    }
}

int main() {
    No* raiz = NULL;
    Documento doc;
    int alturaAntes, alturaDepois;

    printf("--- Cadastro de Documentos (Biblioteca Digital) ---\n\n");

    for (int i = 1; i <= 2; i++) {
        printf("Digite os dados do %dº documento:\n", i);
        
        printf("ID: ");
        scanf("%d", &doc.id);
        limparBuffer();

        printf("Titulo: ");
        fgets(doc.titulo, sizeof(doc.titulo), stdin);
        removerQuebraLinha(doc.titulo);

        printf("Autor: ");
        fgets(doc.autor, sizeof(doc.autor), stdin);
        removerQuebraLinha(doc.autor);

        printf("Ano de Publicacao: ");
        scanf("%d", &doc.ano);
        limparBuffer();

        raiz = inserir(raiz, doc);
        printf("-----------------------------------------\n");
    }

    // 2. Calcula a altura antes do balanceamento
    alturaAntes = calcularAltura(raiz);

    // 1. Aplica o Algoritmo DSW para balancear a árvore
    raiz = balancearDSW(raiz);

    // 2. Calcula a altura após o balanceamento
    alturaDepois = calcularAltura(raiz);

    // 3. Exibe os resultados formatados
    printf("\n=================== RESULTADOS ===================\n");
    printf("\n--- Documentos Armazenados (Percurso Em-Ordem) ---\n");
    if (raiz == NULL) {
        printf("Nenhum documento cadastrado.\n");
    } else {
        exibirEmOrdem(raiz);
    }
    
    printf("\n--- Analise de Altura da Arvore ---\n");
    printf("Altura ANTES do DSW (original):    %d\n", alturaAntes);
    printf("Altura DEPOIS do DSW (balanceada): %d\n", alturaDepois);
    printf("==================================================\n");

    liberarArvore(raiz);
    return 0;
}
